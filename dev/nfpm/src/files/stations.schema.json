{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrayBeat stations",
  "type": "object",
  "properties": {
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StationItem"
      }
    }
  },
  "required": [
    "stations"
  ],
  "definitions": {
    "StationItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of the entry.",
          "enum": ["webradio", "separator", "folder", "playlist"]
        },
        "uniqueId": {
          "type": "string",
          "description": "Is awarded by the program.",
          "format": "uuid"
        },
        "caption": {
          "type": ["string", "null"],
          "description": "The caption of the menu item."
        },
        "url": {
          "type": ["string", "null"],
          "description": "If type is webradio then this is the url to the webradio.",
          "format": "uri"
        },
        "volumeDelta": {
          "type": "integer",
          "description": "Adjusts the volume for this station and is set as a percentage (±)"
        },
        "path": {
          "type": ["string", "null"],
          "description": "If type is playlist then this is the path to the webradio. You can also insert environmentvariables like ${Home}."
        },
        "items": {
          "type": ["array", "null"],
          "description": "If type is folder this ar the sub items.",
          "items": {
            "$ref": "#/definitions/StationItem"
          }
        }
      },
      "required": [
        "type"
      ]
    }
  }
}